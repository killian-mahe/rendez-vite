# Copy this file to .env and adjust it. Every variable is optional.

RENDEZ_VITE_LOG_LEVEL=INFO

# Temporal
RENDEZ_VITE_TEMPORAL_ADDRESS=localhost:7233
RENDEZ_VITE_TEMPORAL_NAMESPACE=default
RENDEZ_VITE_TEMPORAL_TASK_QUEUE=rendez-vite
RENDEZ_VITE_TEMPORAL_TLS=false
# RENDEZ_VITE_TEMPORAL_API_KEY=

# Adapters used when the watch command does not name one
RENDEZ_VITE_DEFAULT_PROVIDER=fake
RENDEZ_VITE_DEFAULT_NOTIFIER=console

# SMTP notifier (STARTTLS)
RENDEZ_VITE_SMTP_HOST=smtp.example.org
RENDEZ_VITE_SMTP_PORT=587
RENDEZ_VITE_SMTP_USE_TLS=true
RENDEZ_VITE_SMTP_SENDER=rendez-vite@example.org
# RENDEZ_VITE_SMTP_USERNAME=
# RENDEZ_VITE_SMTP_PASSWORD=
RENDEZ_VITE_SMTP_TIMEOUT_SECONDS=10

# HTTP provider
RENDEZ_VITE_BOOKING_API_BASE_URL=https://booking.example.org/api
# RENDEZ_VITE_BOOKING_API_TOKEN=
RENDEZ_VITE_BOOKING_API_TIMEOUT_SECONDS=10

# Fake provider (demo)
RENDEZ_VITE_FAKE_SEED=rendez-vite
RENDEZ_VITE_FAKE_RELEASE_RATE=0.05
RENDEZ_VITE_FAKE_TIMEZONE=Europe/Paris
